# Chave da API DeepSeek — configurar no Environment do Dokploy, nunca no repositorio
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# deepseek-v4-pro (melhor julgamento) ou deepseek-v4-flash (mais barato/rapido)
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

PORT=8080
DATA_DIR=/app/data
